# Public canonical URL used in metadata and customer tracking links.
NEXT_PUBLIC_SITE_URL=https://zhoppin.ng

# MongoDB Atlas driver connection string. Keep this server-side and private.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=zhoppin

# Admin login. Generate the hash with: npm run admin:hash -- "your password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=PASTE_GENERATED_SALT_AND_HASH

# Generate with: openssl rand -base64 48
AUTH_SECRET=PASTE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
